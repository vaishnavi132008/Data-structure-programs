class AVLNode:
    
    def __init__(self, enrollment_id, student_name, course_name):
        self.enrollment_id = enrollment_id
        self.student_name = student_name
        self.course_name = course_name
        self.left = None
        self.right = None
        self.height = 1


class CourseEnrollmentAVLTree:
    
    
    def height(self, node):
        if not node:
            return 0
        return node.height

    def get_balance(self, node):
        
        if not node:
            return 0
        return self.height(node.left) - self.height(node.right)

    def right_rotate(self, y):
        x = y.left
        T2 = x.right

        x.right = y
        y.left = T2

        y.height = max(self.height(y.left), self.height(y.right)) + 1
        x.height = max(self.height(x.left), self.height(x.right)) + 1

        return x

    def left_rotate(self, x):
        y = x.right
        T2 = y.left

        y.left = x
        x.right = T2

        x.height = max(self.height(x.left), self.height(x.right)) + 1
        y.height = max(self.height(y.left), self.height(y.right)) + 1

        return y

    
    def insert(self, root, enrollment_id, student_name, course_name):
        if not root:
            print(f"-> Success: Enrolled {student_name} (ID: {enrollment_id}) in {course_name}.")
            return AVLNode(enrollment_id, student_name, course_name)
        
        if enrollment_id < root.enrollment_id:
            root.left = self.insert(root.left, enrollment_id, student_name, course_name)
        elif enrollment_id > root.enrollment_id:
            root.right = self.insert(root.right, enrollment_id, student_name, course_name)
        else:
            print(f"-> Error: Enrollment ID {enrollment_id} already exists!")
            return root

        root.height = 1 + max(self.height(root.left), self.height(root.right))
        balance = self.get_balance(root)

        
        if balance > 1 and enrollment_id < root.left.enrollment_id:
            return self.right_rotate(root)
        if balance < -1 and enrollment_id > root.right.enrollment_id:
            return self.left_rotate(root)
        if balance > 1 and enrollment_id > root.left.enrollment_id:
            root.left = self.left_rotate(root.left)
            return self.right_rotate(root)
        if balance < -1 and enrollment_id < root.right.enrollment_id:
            root.right = self.right_rotate(root.right)
            return self.left_rotate(root)

        return root

    
    def get_min_value_node(self, node):
        current = node
        while current.left is not None:
            current = current.left
        return current

    def delete(self, root, enrollment_id):
        if not root:
            print(f"-> Error: Enrollment ID {enrollment_id} not found.")
            return root

        if enrollment_id < root.enrollment_id:
            root.left = self.delete(root.left, enrollment_id)
        elif enrollment_id > root.enrollment_id:
            root.right = self.delete(root.right, enrollment_id)
        else:
            print(f"-> Success: Removed enrollment ID {enrollment_id} ({root.student_name}).")
            if root.left is None:
                return root.right
            elif root.right is None:
                return root.left

            temp = self.get_min_value_node(root.right)
            root.enrollment_id = temp.enrollment_id
            root.student_name = temp.student_name
            root.course_name = temp.course_name
            root.right = self.delete(root.right, temp.enrollment_id)

        if not root:
            return root

        root.height = 1 + max(self.height(root.left), self.height(root.right))
        balance = self.get_balance(root)

        if balance > 1 and self.get_balance(root.left) >= 0:
            return self.right_rotate(root)
        if balance > 1 and self.get_balance(root.left) < 0:
            root.left = self.left_rotate(root.left)
            return self.right_rotate(root)
        if balance < -1 and self.get_balance(root.right) <= 0:
            return self.left_rotate(root)
        if balance < -1 and self.get_balance(root.right) > 0:
            root.right = self.right_rotate(root.right)
            return self.left_rotate(root)

        return root

    
    def search_by_id(self, root, enrollment_id):
        if not root or root.enrollment_id == enrollment_id:
            return root
        if root.enrollment_id < enrollment_id:
            return self.search_by_id(root.right, enrollment_id)
        return self.search_by_id(root.left, enrollment_id)

    def search_by_name(self, root, student_name, results=None):
        if results is None:
            results = []
        if root:
            if student_name.lower() in root.student_name.lower():
                results.append(root)
            self.search_by_name(root.left, student_name, results)
            self.search_by_name(root.right, student_name, results)
        return results

    
    def in_order_traversal(self, root, result=None):
        if result is None:
            result = []
        if root:
            self.in_order_traversal(root.left, result)
            result.append({
                "ID": root.enrollment_id,
                "Name": root.student_name,
                "Course": root.course_name
            })
            self.in_order_traversal(root.right, result)
        return result

    
    def count_enrollments(self, root):
        if not root:
            return 0
        return 1 + self.count_enrollments(root.left) + self.count_enrollments(root.right)



def main():
    system = CourseEnrollmentAVLTree()
    root = None


    sample_data = [
        (104, "Alice Smith", "Python Programming"),
        (101, "Bob Jones", "Data Structures"),
        (105, "Charlie Brown", "Machine Learning"),
        (102, "Diana Prince", "Web Development")
    ]
    for eid, name, course in sample_data:
        root = system.insert(root, eid, name, course)

    while True:
        print("\n========================================")
        print("   ONLINE COURSE ENROLLMENT SYSTEM (AVL)")
        print("========================================")
        print("1. Insert a Student Enrollment")
        print("2. Delete an Enrollment Record by ID")
        print("3. Search for Student (by ID or Name)")
        print("4. Display All Enrollments (In-Order Sorted)")
        print("5. Count Total Enrollments")
        print("6. Exit")
        
        choice = input("Enter your choice (1-6): ").strip()

        if choice == '1':
            try:
                eid = int(input("Enter Enrollment ID (integer): "))
                name = input("Enter Student Name: ").strip()
                course = input("Enter Course Name: ").strip()
                root = system.insert(root, eid, name, course)
            except ValueError:
                print("-> Error: Invalid input type for ID. Please enter a valid number.")

        elif choice == '2':
            try:
                eid = int(input("Enter Enrollment ID to delete: "))
                root = system.delete(root, eid)
            except ValueError:
                print("-> Error: Invalid input type for ID.")

        elif choice == '3':
            print("\n--- Search Sub-Menu ---")
            print("a. Search by Enrollment ID")
            print("b. Search by Student Name")
            sub_choice = input("Choose option (a/b): ").strip().lower()

            if sub_choice == 'a':
                try:
                    eid = int(input("Enter Enrollment ID: "))
                    node = system.search_by_id(root, eid)
                    if node:
                        print(f"\n[Found Match]")
                        print(f"ID: {node.enrollment_id} | Name: {node.student_name} | Course: {node.course_name}")
                    else:
                        print(f"-> No record found with ID {eid}.")
                except ValueError:
                    print("-> Error: Invalid ID format.")
            elif sub_choice == 'b':
                name_query = input("Enter student name (or part of it): ").strip()
                matches = system.search_by_name(root, name_query)
                if matches:
                    print(f"\n[Found {len(matches)} Match(es)]")
                    for m in matches:
                        print(f"ID: {m.enrollment_id} | Name: {m.student_name} | Course: {m.course_name}")
                else:
                    print(f"-> No students found matching '{name_query}'.")
            else:
                print("-> Invalid search option.")

        elif choice == '4':
            records = system.in_order_traversal(root)
            print(f"\n--- All Enrollments (Sorted by ID) [Total: {len(records)}] ---")
            if not records:
                print("No active enrollments.")
            else:
                print(f"{'ID':<6} | {'Student Name':<20} | {'Course Name'}")
                print("-" * 50)
                for r in records:
                    print(f"{r['ID']:<6} | {r['Name']:<20} | {r['Course']}")

        elif choice == '5':
            total = system.count_enrollments(root)
            print(f"\n-> Total active student enrollments: {total}")

        elif choice == '6':
            print("\nExiting system. Goodbye!")
            break
        else:
            print("-> Invalid choice. Please select an option between 1 and 6.")

if __name__ == "__main__":
    main()

